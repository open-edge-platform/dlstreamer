#!/usr/bin/make -f
DEB_BUILD_OPTIONS=nostrip
PYTHON_LIBDIR := $(shell if [ -x /python3venv/bin/python ]; then /python3venv/bin/python -c 'import sysconfig; print(sysconfig.get_config_var("LIBDIR"))'; fi)
PYTHON_LIBDIR_ARGS := $(if $(PYTHON_LIBDIR),-l$(PYTHON_LIBDIR))
DEB_DH_SHLIBDEPS_ARGS_ALL=--dpkg-shlibdeps-params=="--ignore-missing-info -l./libraries/usr/lib -l./libraries/usr/local/lib -l./libraries/usr/lib/x86_64-linux-gnu $(PYTHON_LIBDIR_ARGS)"

%:
	dh $@ -l/opt/opencv

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params="--ignore-missing-info -l$(CURDIR)/opt/intel/dlstreamer/gstreamer/lib -l./libraries/usr/lib -l./libraries/usr/local/lib -l./libraries/usr/lib/x86_64-linux-gnu $(PYTHON_LIBDIR_ARGS)"
