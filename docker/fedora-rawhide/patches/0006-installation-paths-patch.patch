From 4d1a1bf69721cce838843b5a22fc924931f4ee14 Mon Sep 17 00:00:00 2001
From: Michal Holownia <michal.holownia@intel.com>
Date: Fri, 30 Oct 2026 12:41:17 +0100
Subject: [PATCH] installation paths patch

---
 CMakeLists.txt                                | 13 ++++++++++---
 cmake/dl-streamer.pc.in                       |  4 ++--
 python/CMakeLists.txt                         |  4 ++--
 samples/gstreamer/CMakeLists.txt              |  4 ++--
 src/gst/lib/CMakeLists.txt                    |  6 +++++-
 src/gst/metadata/CMakeLists.txt               |  6 +++++-
 src/gst/metadata/generate_gir.cmake           |  6 ++++--
 src/gst/metadata/generate_watermark_gir.cmake |  6 ++++--
 8 files changed, 34 insertions(+), 15 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d083cc56..7aac35c6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -100,9 +100,16 @@ foreach(OUTPUTCONFIG ${CMAKE_CONFIGURATION_TYPES})
     set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_${OUTPUTCONFIG_UPPER} ${CMAKE_BINARY_DIR}/${BIN_FOLDER}/${OUTPUTCONFIG}/bin)
 endforeach()
 
-set (DLSTREAMER_LIBRARIES_INSTALL_PATH lib)
-set (DLSTREAMER_PLUGINS_INSTALL_PATH ${DLSTREAMER_LIBRARIES_INSTALL_PATH}/gstreamer-1.0)
-set (DLSTREAMER_HEADERS_INSTALL_PATH include)
+# Install paths are relative to CMAKE_INSTALL_PREFIX, distribution packages can override them
+set (DLSTREAMER_LIBRARIES_INSTALL_PATH lib CACHE STRING "Install path for libraries")
+set (DLSTREAMER_PLUGINS_INSTALL_PATH ${DLSTREAMER_LIBRARIES_INSTALL_PATH}/gstreamer-1.0 CACHE STRING "Install path for GStreamer plugins")
+set (DLSTREAMER_SHARED_LIBS_INSTALL_PATH ${DLSTREAMER_PLUGINS_INSTALL_PATH} CACHE STRING "Install path for shared libraries linked by the plugins")
+set (DLSTREAMER_HEADERS_INSTALL_PATH include CACHE STRING "Install path for headers")
+set (DLSTREAMER_GIR_INSTALL_PATH share/gir-1.0 CACHE STRING "Install path for GIR files")
+set (DLSTREAMER_TYPELIB_INSTALL_PATH ${DLSTREAMER_LIBRARIES_INSTALL_PATH}/girepository-1.0 CACHE STRING "Install path for typelib files")
+set (DLSTREAMER_PYTHON_INSTALL_PATH python CACHE STRING "Install path for Python modules")
+set (DLSTREAMER_SAMPLES_INSTALL_PATH samples CACHE STRING "Install path for samples")
+set (DLSTREAMER_SOVERSION "" CACHE STRING "SOVERSION of the shared libraries, unversioned when empty")
 
 # include and lib folders of this project
 set (DLSTREAMER_BASE_DIR ${CMAKE_CURRENT_SOURCE_DIR})
diff --git a/cmake/dl-streamer.pc.in b/cmake/dl-streamer.pc.in
index 1987e373..9a7cf284 100644
--- a/cmake/dl-streamer.pc.in
+++ b/cmake/dl-streamer.pc.in
@@ -1,7 +1,7 @@
 prefix=${pcfiledir}/../..
 exec_prefix=${prefix}/bin
-libdir=${prefix}/lib
-includedir=${prefix}/include
+libdir=${prefix}/@DLSTREAMER_LIBRARIES_INSTALL_PATH@
+includedir=${prefix}/@DLSTREAMER_HEADERS_INSTALL_PATH@
 Name: Deep Learning Streamer (DL Streamer) Pipeline Framework
 Description: Elements that enable Deep Learning inference and media analytics capabilities in the GStreamer framework
 Version:@VERSION_MAJOR@.@VERSION_MINOR@.@VERSION_PATCH@
diff --git a/python/CMakeLists.txt b/python/CMakeLists.txt
index ab573fd8..bbc22c4b 100644
--- a/python/CMakeLists.txt
+++ b/python/CMakeLists.txt
@@ -5,14 +5,14 @@
 # ==============================================================================
 
 install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/gstgva
-        DESTINATION python
+        DESTINATION ${DLSTREAMER_PYTHON_INSTALL_PATH}
         USE_SOURCE_PERMISSIONS
         PATTERN "*.pyc" EXCLUDE
         PATTERN "__pycache__" EXCLUDE
         PATTERN "CMakeLists.txt" EXCLUDE)
 
 install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/dlstreamer
-        DESTINATION python
+        DESTINATION ${DLSTREAMER_PYTHON_INSTALL_PATH}
         USE_SOURCE_PERMISSIONS
         PATTERN "*.pyc" EXCLUDE
         PATTERN "__pycache__" EXCLUDE)
diff --git a/samples/gstreamer/CMakeLists.txt b/samples/gstreamer/CMakeLists.txt
index e33a8d1d..ebd73a5e 100644
--- a/samples/gstreamer/CMakeLists.txt
+++ b/samples/gstreamer/CMakeLists.txt
@@ -12,7 +12,7 @@ add_custom_command(TARGET copy_model_proc POST_BUILD
         COMMAND ${CMAKE_COMMAND} -E copy_directory
         ${CMAKE_CURRENT_SOURCE_DIR}/model_proc ${CMAKE_SAMPLES_OUTPUT_DIRECTORY}/model_proc)
 
-install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/ DESTINATION samples USE_SOURCE_PERMISSIONS PATTERN "cpp" EXCLUDE PATTERN "CMakeLists.txt" EXCLUDE)
+install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/ DESTINATION ${DLSTREAMER_SAMPLES_INSTALL_PATH} USE_SOURCE_PERMISSIONS PATTERN "cpp" EXCLUDE PATTERN "CMakeLists.txt" EXCLUDE)
 # Separate install because 'cpp' folder contains CMakeLists.txt which we ignored in above command
-install(DIRECTORY cpp DESTINATION samples USE_SOURCE_PERMISSIONS)
+install(DIRECTORY cpp DESTINATION ${DLSTREAMER_SAMPLES_INSTALL_PATH} USE_SOURCE_PERMISSIONS)
 endif()
diff --git a/src/gst/lib/CMakeLists.txt b/src/gst/lib/CMakeLists.txt
index 58fb62a0..98d4b7ce 100644
--- a/src/gst/lib/CMakeLists.txt
+++ b/src/gst/lib/CMakeLists.txt
@@ -50,4 +50,8 @@ if(WIN32)
     )
 endif()
 
-install(TARGETS ${TARGET_NAME} DESTINATION ${DLSTREAMER_PLUGINS_INSTALL_PATH})
+install(TARGETS ${TARGET_NAME} DESTINATION ${DLSTREAMER_SHARED_LIBS_INSTALL_PATH})
+
+if(DLSTREAMER_SOVERSION)
+    set_target_properties(${TARGET_NAME} PROPERTIES SOVERSION ${DLSTREAMER_SOVERSION})
+endif()
diff --git a/src/gst/metadata/CMakeLists.txt b/src/gst/metadata/CMakeLists.txt
index 9dcd878d..5a715ab5 100644
--- a/src/gst/metadata/CMakeLists.txt
+++ b/src/gst/metadata/CMakeLists.txt
@@ -36,7 +36,11 @@ target_link_libraries(${TARGET_NAME}
                 ${GSTANALYTICS_LIBRARIES}
 )
 
-install(TARGETS ${TARGET_NAME} DESTINATION ${DLSTREAMER_PLUGINS_INSTALL_PATH})
+install(TARGETS ${TARGET_NAME} DESTINATION ${DLSTREAMER_SHARED_LIBS_INSTALL_PATH})
+
+if(DLSTREAMER_SOVERSION)
+    set_target_properties(${TARGET_NAME} PROPERTIES SOVERSION ${DLSTREAMER_SOVERSION})
+endif()
 
 # Generate GObject Introspection (GIR) files
 include(generate_gir.cmake)
diff --git a/src/gst/metadata/generate_gir.cmake b/src/gst/metadata/generate_gir.cmake
index 84da1112..4e12632b 100644
--- a/src/gst/metadata/generate_gir.cmake
+++ b/src/gst/metadata/generate_gir.cmake
@@ -127,6 +127,8 @@ endif()
 set(TYPELIB_SHARED_LIB_ARGS)
 if(WIN32)
     set(TYPELIB_SHARED_LIB_ARGS --shared-library=dlstreamer_gst_meta.dll)
+elseif(DLSTREAMER_SOVERSION)
+    set(TYPELIB_SHARED_LIB_ARGS --shared-library=libdlstreamer_gst_meta.so.${DLSTREAMER_SOVERSION})
 endif()
 
 add_custom_command(
@@ -148,8 +150,8 @@ add_custom_target(metadata_introspection ALL
 # Use the same location where GStreamer installs its GIR files
 pkg_get_variable(GSTREAMER_PREFIX gstreamer-1.0 prefix)
 
-set(GIR_INSTALL_DIR "${CMAKE_INSTALL_PREFIX}/share/gir-1.0")
-set(TYPELIB_INSTALL_DIR "${CMAKE_INSTALL_PREFIX}/lib/girepository-1.0")
+set(GIR_INSTALL_DIR "${DLSTREAMER_GIR_INSTALL_PATH}")
+set(TYPELIB_INSTALL_DIR "${DLSTREAMER_TYPELIB_INSTALL_PATH}")
 
 
 install(FILES ${GIR_OUTPUT}
diff --git a/src/gst/metadata/generate_watermark_gir.cmake b/src/gst/metadata/generate_watermark_gir.cmake
index bec15f56..797b30f1 100644
--- a/src/gst/metadata/generate_watermark_gir.cmake
+++ b/src/gst/metadata/generate_watermark_gir.cmake
@@ -109,6 +109,8 @@ endif()
 set(TYPELIB_SHARED_LIB_ARGS)
 if(WIN32)
     set(TYPELIB_SHARED_LIB_ARGS --shared-library=dlstreamer_gst_meta.dll)
+elseif(DLSTREAMER_SOVERSION)
+    set(TYPELIB_SHARED_LIB_ARGS --shared-library=libdlstreamer_gst_meta.so.${DLSTREAMER_SOVERSION})
 endif()
 
 add_custom_command(
@@ -127,8 +129,8 @@ add_custom_target(watermark_introspection ALL
 )
 
 # Install watermark GIR and typelib files to GStreamer's directories
-set(GIR_INSTALL_DIR "${CMAKE_INSTALL_PREFIX}/share/gir-1.0")
-set(TYPELIB_INSTALL_DIR "${CMAKE_INSTALL_PREFIX}/lib/girepository-1.0")
+set(GIR_INSTALL_DIR "${DLSTREAMER_GIR_INSTALL_PATH}")
+set(TYPELIB_INSTALL_DIR "${DLSTREAMER_TYPELIB_INSTALL_PATH}")
 
 install(FILES ${WATERMARK_GIR_OUTPUT}
     DESTINATION ${GIR_INSTALL_DIR}
