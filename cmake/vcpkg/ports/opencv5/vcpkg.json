{
  "name": "opencv5",
  "version": "5.1.0",
  "description": "Open Source Computer Vision Library",
  "homepage": "https://opencv.org/",
  "license": "Apache-2.0",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "zlib"
  ],
  "features": {
    "calib": {
      "description": "Camera calibration module"
    },
    "geometry": {
      "description": "Geometry module"
    },
    "fs": {
      "description": "Filesystem support"
    },
    "intrinsics": {
      "description": "Enable CPU intrinsics"
    },
    "jpeg": {
      "description": "JPEG image support",
      "dependencies": [
        "libjpeg-turbo"
      ]
    },
    "opencl": {
      "description": "OpenCL support",
      "dependencies": [
        "opencl"
      ]
    },
    "png": {
      "description": "PNG image support",
      "dependencies": [
        "libpng"
      ]
    },
    "thread": {
      "description": "Thread support"
    },
    "win32ui": {
      "description": "Windows UI support",
      "supports": "windows"
    },
    "world": {
      "description": "Build the combined world library"
    }
  }
}
