#
# Single source of truth for versions of the main DL Streamer dependencies.
#
# Files that cannot read this file directly (Dockerfiles, CI workflows,
# requirements files, docs, PowerShell scripts) keep a copy of the value, and
# scripts/check_versions.py verifies that every copy matches. After bumping a
# version here, run:
#
#   python3 scripts/check_versions.py --fix
#
# which rewrites all copies and regenerates requirements/constraints.txt.

# GStreamer (built from source on Linux, MSVC installer on Windows)
GSTREAMER_VERSION=1.28.8

# OpenVINO GenAI archive used on Ubuntu, EMT and Windows. It bundles the full
# OpenVINO C++ runtime, so no separate OpenVINO archive is needed.
OPENVINO_GENAI_VERSION=2026.5.0.0.dev20261027

# Plain OpenVINO archive (scripts/install_dependencies/install_openvino.sh, EMT)
OPENVINO_ARCHIVE_BUILD=2026.5.0-23594-7e507a4ca9a
OPENVINO_ARCHIVE_VERSION=2026.5.0.dev20261027

# OpenVINO Python wheels used by model download/export tools. They must match
# the OpenVINO runtime above, so models are exported with the same version.
OPENVINO_WHEEL_VERSION=2026.5.0.dev20261027
OPENVINO_TOKENIZERS_WHEEL_VERSION=2026.5.0.0.dev20261027
# Extra package index for nightly wheels; leave empty for official releases.
OPENVINO_WHEEL_EXTRA_INDEX=https://storage.openvinotoolkit.org/simple/wheels/nightly

# OpenVINO packages from Intel's YUM repository (Fedora image, RPM spec files).
# No nightly RPMs are published, so these stay on the latest official release.
OPENVINO_RPM_VERSION=2026.3.1
