 namespace BEVFusionExtension {
 
+// ============================================================
+// OpenMP team size
+//
+// The OpenMP loops here are short and memory bound. OpenMP's default team of
+// one thread per core costs far more in wake-ups and cross-socket traffic than
+// it saves: about 1 s per frame on a 128-thread two-socket Xeon, against a few
+// ms with four threads. So the team is capped unless OMP_NUM_THREADS sets it.
+// ============================================================
+static int omp_team_size() {
+#ifdef _OPENMP
+    static const int n = std::getenv("OMP_NUM_THREADS") ? omp_get_max_threads()
+                                                        : std::min(omp_get_max_threads(), 4);
+    return n;
+#else
+    return 1;
+#endif
+}
+
 // ============================================================
 // Diagnostic output
 //
@@ -286,7 +306,31 @@ static void gpu_f32_to_f16(cl_mem f32, cl_mem f16, int total) {
 // ============================================================
 // OpenCL Initialization
 // ============================================================
+// The GPU to run on, as the 32 hex digits of its UUID (CL_DEVICE_UUID_KHR,
+// which OpenVINO reports as the GPU device's DEVICE_UUID), from
+// BEVFUSION_OPENCL_DEVICE_UUID. Empty: the first Intel GPU. Read once, at the
+// first inference.
+static std::string requested_device_uuid() {
+    const char* v = std::getenv("BEVFUSION_OPENCL_DEVICE_UUID");
+    std::string uuid = v ? v : "";
+    for (auto& c : uuid) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return uuid;
+}
+
+static std::string device_uuid(cl_device_id d) {
+    cl_uchar uuid[CL_UUID_SIZE_KHR] = {};
+    if (clGetDeviceInfo(d, CL_DEVICE_UUID_KHR, sizeof(uuid), uuid, nullptr) != CL_SUCCESS) return "";
+    static const char* hex = "0123456789abcdef";
+    std::string s;
+    for (cl_uchar b : uuid) {
+        s += hex[b >> 4];
+        s += hex[b & 15];
+    }
+    return s;
+}
+
 static void init_opencl() {
+    const std::string wanted_uuid = requested_device_uuid();
