        <type name="gsize" c:type="gsize" />
      </field>
      <field name="skeleton_connections" writable="1">
        <doc xml:space="preserve" filename="include/dlstreamer/gst/metadata/gstanalyticskeypointdescriptor.h" line="21">Array of int pairs (index_a, index_b) into
  @point_names describing the skeleton edges. Length is
  @skeleton_connection_count * 2.</doc>
        <type name="gint" c:type="const gint*" />
      </field>
      <field name="skeleton_connection_count" writable="1">
        <doc xml:space="preserve" filename="include/dlstreamer/gst/metadata/gstanalyticskeypointdescriptor.h" line="24">Number of skeleton connection pairs.</doc>
        <type name="gsize" c:type="gsize" />
      </field>
      <method name="get_point_name" c:identifier="gst_analytics_keypoint_descriptor_get_point_name">
        <doc xml:space="preserve" filename="src/gst/metadata/gstanalyticskeypointdescriptor.c" line="186">Get the name of the keypoint at @index.

This accessor exists for GObject Introspection (Python) bindings.
C/C++ code should access the struct fields directly.</doc>
        <source-position filename="include/dlstreamer/gst/metadata/gstanalyticskeypointdescriptor.h" line="58" />
        <return-value transfer-ownership="none" nullable="1">
          <doc xml:space="preserve" filename="src/gst/metadata/gstanalyticskeypointdescriptor.c" line="196">the keypoint name, or %NULL if
  @index is out of range.</doc>
          <type name="utf8" c:type="const gchar*" />
        </return-value>
        <parameters>
          <instance-parameter name="desc" transfer-ownership="none">
            <doc xml:space="preserve" filename="src/gst/metadata/gstanalyticskeypointdescriptor.c" line="188">a #GstAnalyticsKeypointDescriptor</doc>
            <type name="KeypointDescriptor" c:type="const GstAnalyticsKeypointDescriptor*" />
